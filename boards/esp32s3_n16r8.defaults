# ---------------------------------------------------------------------------
# Board: ESP32-S3-WROOM-1U-N16R8 DevKit (DevKitC-1, 2 x 22 pins)
#        BOARD=esp32s3_n16r8   IDF_TARGET=esp32s3
#
#   Chip    ESP32-S3R8, Xtensa LX7 dual-core 240 MHz, 512 KB SRAM
#   Flash   16 MB QUAD SPI, 3.3 V              (N16)
#   PSRAM   8 MB OCTAL SPI, 3.3 V, GPIO35-37   (R8)
#   Antenna external, u.FL connector (the "U")
#   Console UART0 (GPIO43/44) = the "UART"/"COM" USB connector of the DevKitC-1
#           -> /dev/ttyUSB0 (CP2102) or /dev/ttyACM0 (CH343)
#
# The partition table (partitions.csv) stays the 4 MB layout of the ESP32
# build: the rest of the 16 MB is free.
# Loaded after sdkconfig.defaults (see CMakeLists.txt).
# Factory pins of the RFM95W: main/node_board.h. Guide: doc/hardware/ESP32-S3-WROOM-1U_N16R8_DevKit.md
# ---------------------------------------------------------------------------
CONFIG_NODE_BOARD_ESP32S3_WROOM_1U_N16R8=y

# Flash: 16 MB quad, 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: 8 MB octal, 80 MHz, added to the heap
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
