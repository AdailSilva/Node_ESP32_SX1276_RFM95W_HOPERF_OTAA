# LoRaWAN node (ESP32 DevKit + RFM95W) — ESP-IDF defaults common to the
# three boards. Flash, PSRAM and the board choice are in boards/<board>.defaults
# (esp32, esp32s3_n16r8, esp32s3_n32r16v), loaded after this file.
# "sdkconfig.<board>" is generated by the build (scripts/build.sh <board>).

# partitions.csv = same layout as the Arduino firmware (4 MB), so the NVS
# (configuration + ABP FCnt) survives the move to ESP-IDF. On the 16/32 MB S3
# modules the space after 4 MB stays free.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 1 ms tick: the LoRaWAN task wakes every millisecond (or on a DIO interrupt)
CONFIG_FREERTOS_HZ=1000

# Browsers send long headers (Authorization, cookies, User-Agent)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512

# Console on UART0 at 115200 bps (idf.py monitor default), on every board:
# ESP32 GPIO1/3, ESP32-S3 GPIO43/44 (the "UART" USB connector of the DevKitC-1).
# UART (not the S3 native USB) because the speed is set on the web page.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# app_main starts Wi-Fi, mDNS and the web server
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
